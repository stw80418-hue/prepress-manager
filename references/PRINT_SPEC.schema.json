{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRINT_SPEC",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "review_status",
    "overrides",
    "evidence",
    "manual_requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": [
        "needs_review",
        "reviewed"
      ]
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bleed_mm": {
          "type": "number",
          "minimum": 0
        },
        "safe_margin_mm": {
          "type": "number",
          "minimum": 0
        },
        "minimum_font_size_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_image_ppi": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "image_warning_ppi": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_line_width_pt": {
          "type": "number",
          "minimum": 0
        },
        "maximum_tac_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "preferred_color_mode": {
          "enum": [
            "CMYK",
            "RGB",
            "Grayscale",
            "Lab",
            "Spot"
          ]
        },
        "target_size_mm": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "size_tolerance_mm": {
          "type": "number",
          "minimum": 0
        },
        "require_uniform_artboards": {
          "type": "boolean"
        },
        "require_outlined_text": {
          "type": "boolean"
        },
        "allow_spot_colors": {
          "type": "boolean"
        },
        "required_pdf_x": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_pdf_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_icc_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "small_black_text_max_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "large_black_area_mm2": {
          "type": "number",
          "minimum": 0
        },
        "black_k_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "black_rgb_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "special_process_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maximum_ai_major_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "quote",
          "location"
        ],
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "manual_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
